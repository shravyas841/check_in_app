generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model AuditLog {
  id         String   @id
  action     String
  resource   String
  resourceId String?
  details    Json?
  userId     String
  userName   String
  userRole   String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([resource])
  @@index([userId, createdAt])
}

model User {
  id               String   @id // Clerk user ID
  email            String   @unique
  firstName        String?
  lastName         String?
  name             String?
  password         String?
  imageUrl         String?
  role             String   @default("UNAUTHORIZED")
  assignedEventIds String[] @default([])
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organizedEvents  Event[]  @relation("OrganizerEvents")
  tickets          Ticket[]

  @@index([role])
  @@index([isActive, role])
}

model Event {
  id                   String                @id
  name                 String
  description          String?
  date                 DateTime
  startTime            String                @default("09:00")
  endTime              String                @default("18:00")
  venue                String?
  address              String?
  price                Int                   @default(0)
  entryFee             Int                   @default(0)
  prizePool            Int                   @default(0)
  category             String                @default("other")
  imageUrl             String?
  capacity             Int                   @default(100)
  soldCount            Int                   @default(0)
  isActive             Boolean               @default(true)
  // Sales availability and public publication are separate controls.
  publicationStatus    String                @default("published")
  publishApprovedBy    String?
  publishApprovedAt    DateTime?
  timezone             String                @default("Asia/Kolkata")
  isFeatured           Boolean               @default(false)
  schedule             Json                  @default("[]")
  speakers             Json                  @default("[]")
  sponsors             Json                  @default("[]")
  tags                 String[]              @default([])
  organizer            String?
  organizerId          String?
  contactEmail         String?
  contactPhone         String?
  termsAndConditions   String?
  registrationDeadline String?
  earlyBirdEnabled     Boolean               @default(false)
  earlyBirdPrice       Int                   @default(0)
  earlyBirdDeadline    String?
  sendReminders        Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  registrationFields   Json                  @default("[]")
  organizerVideoLink   String?
  videoLink            String?
  PricingRule          PricingRule[]
  Review               Review[]
  Session              Session[]
  Ticket               Ticket[]
  CertificateTemplate  CertificateTemplate?
  AttendeeSegment      AttendeeSegment[]
  ReminderSchedule     ReminderSchedule?
  TicketType           TicketType[]
  BackgroundJob        BackgroundJob[]
  ScannerHeartbeat     ScannerHeartbeat[]
  StaffShift           StaffShift[]
  OperationalIncident  OperationalIncident[]
  OrganizerUser        User?                 @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([isActive])
  @@index([organizerId])
  @@index([isActive, date])
  @@index([isFeatured, isActive])
  @@index([publicationStatus, date])
  @@index([date])
}

model AttendeeSegment {
  id          String   @id @default(uuid())
  name        String
  description String?
  eventId     String?
  filters     Json     @default("{}")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([createdBy])
  @@index([updatedAt])
}

model EventTemplate {
  id            String   @id @default(uuid())
  name          String
  description   String?
  sourceEventId String?
  data          Json
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdBy])
  @@index([updatedAt])
}

model ReminderSchedule {
  id              String             @id @default(uuid())
  eventId         String             @unique
  enabled         Boolean            @default(false)
  offsetsMinutes  Int[]              @default([10080, 1440, 120])
  channels        String[]           @default(["email"])
  createdBy       String
  lastProcessedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  Event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  Deliveries      ReminderDelivery[]

  @@index([enabled])
  @@index([updatedAt])
}

model ReminderDelivery {
  id            String           @id @default(uuid())
  scheduleId    String
  ticketId      String
  channel       String
  offsetMinutes Int
  scheduledFor  DateTime
  status        String           @default("pending")
  attempts      Int              @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  error         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  Schedule      ReminderSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  Ticket        Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, ticketId, channel, offsetMinutes, scheduledFor])
  @@index([status, scheduledFor])
  @@index([ticketId])
  @@index([scheduleId, createdAt])
}

model PricingRule {
  id              String   @id
  eventId         String
  triggerType     String
  triggerValue    Int
  adjustmentType  String
  adjustmentValue Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  Event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([active])
  @@index([eventId])
  @@index([eventId, active])
}

model Review {
  id        String   @id
  eventId   String
  userName  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  Event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, createdAt])
  @@index([rating])
}

model Session {
  id              String   @id
  eventId         String
  title           String
  description     String?
  type            String   @default("talk")
  speakerName     String?
  speakerRole     String?
  startTime       String
  endTime         String
  date            String
  capacity        Int      @default(100)
  registeredCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  Event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, date, startTime])
}

model SiteConfig {
  id        String   @id @default("default")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id                 String              @id
  name               String
  email              String?
  phone              String?
  eventId            String
  status             String              @default("pending")
  token              String?
  razorpayOrderId    String?
  razorpayPaymentId  String?
  amountPaid         Int                 @default(0)
  grossAmount        Int                 @default(0)
  discountAmount     Int                 @default(0)
  refundedAmount     Int                 @default(0)
  paymentMethod      String?
  checkedIn          Boolean             @default(false)
  checkedInAt        DateTime?
  checkedInBy        String?
  certificateSent    Boolean             @default(false)
  cancelledAt        DateTime?
  lastDeliveredAt    DateTime?
  deliveryCount      Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  customAnswers      Json                @default("{}")
  promoCodeId        String?
  userId             String?
  ticketTypeId       String?
  Event              Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  User               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  TicketType         TicketType?         @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  CheckInLogs        CheckInLog[]
  DeliveryLogs       TicketDeliveryLog[]
  ReminderDeliveries ReminderDelivery[]
  BackgroundJobs     BackgroundJob[]

  @@index([email])
  @@index([eventId])
  @@index([razorpayOrderId])
  @@index([status])
  @@index([token])
  @@index([userId])
  @@index([ticketTypeId])
  @@index([paymentMethod])
  // Composite indexes added for dashboard counters and analytics
  @@index([eventId, status])
  @@index([eventId, checkedIn])
  @@index([eventId, checkedIn, status])
  @@index([eventId, createdAt])
  @@index([eventId, status, createdAt])
  @@index([status, createdAt])
}

model CheckInLog {
  id            String    @id @default(uuid())
  ticketId      String
  eventId       String
  action        String
  performedBy   String
  performedRole String
  ipAddress     String?
  userAgent     String?
  deviceId      String?
  reason        String?
  checksum      String
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([eventId])
  @@index([createdAt])
  @@index([performedBy])
  @@index([eventId, createdAt])
  @@index([eventId, action])
}

model TicketDeliveryLog {
  id          String   @id @default(uuid())
  ticketId    String
  channel     String
  recipient   String?
  success     Boolean
  error       String?
  requestedBy String?
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([channel])
  @@index([createdAt])
  @@index([ticketId, createdAt])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  type      String
  key       String
  ticketId  String?
  eventId   String?
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([key])
  @@index([ticketId])
  @@index([eventId])
  @@index([createdAt])
  @@index([type, createdAt])
}

model PaymentRecoveryJob {
  id            String    @id @default(uuid())
  provider      String    @default("razorpay")
  operation     String
  orderId       String?
  paymentId     String?
  ticketId      String?
  eventId       String?
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([orderId])
  @@index([paymentId])
  @@index([eventId, createdAt])
}

model BackgroundJob {
  id            String    @id @default(uuid())
  type          String
  payload       Json
  status        String    @default("pending")
  priority      Int       @default(0)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  lastError     String?
  completedAt   DateTime?
  dismissedAt   DateTime?
  eventId       String?
  ticketId      String?
  dedupeKey     String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  Event         Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  Ticket        Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt, priority])
  @@index([type, status])
  @@index([eventId, createdAt])
  @@index([ticketId])
}

model WebhookEvent {
  id             String                         @id @default(uuid())
  provider       String                         @default("razorpay")
  idempotencyKey String
  eventType      String
  signatureHash  String
  payload        Json
  status         String                         @default("received")
  attempts       Int                            @default(0)
  lastError      String?
  receivedAt     DateTime                       @default(now())
  processedAt    DateTime?
  Attempts       PaymentReconciliationAttempt[]

  @@unique([provider, idempotencyKey])
  @@index([status, receivedAt])
  @@index([eventType, receivedAt])
}

model PaymentReconciliationAttempt {
  id             String        @id @default(uuid())
  webhookEventId String?
  recoveryJobId  String?
  orderId        String?
  paymentId      String?
  outcome        String
  error          String?
  createdAt      DateTime      @default(now())
  WebhookEvent   WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)

  @@index([webhookEventId, createdAt])
  @@index([recoveryJobId])
  @@index([orderId])
  @@index([paymentId])
}

model TicketType {
  id          String    @id @default(uuid())
  eventId     String
  name        String
  description String?
  price       Int
  capacity    Int
  soldCount   Int       @default(0)
  salesStart  DateTime?
  salesEnd    DateTime?
  minPerOrder Int       @default(1)
  maxPerOrder Int       @default(10)
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  Tickets     Ticket[]

  @@unique([eventId, name])
  @@index([eventId, active, sortOrder])
  @@index([salesStart, salesEnd])
}

model ScannerHeartbeat {
  id            String   @id @default(uuid())
  eventId       String
  userId        String
  deviceId      String
  deviceName    String?
  networkStatus String?
  cameraStatus  String?
  appVersion    String?
  batteryLevel  Int?
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId, eventId])
  @@index([eventId, lastSeenAt])
  @@index([userId, lastSeenAt])
}

model StaffShift {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  userName  String?
  deviceId  String?
  zone      String?
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("scheduled")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startsAt])
  @@index([userId, startsAt])
  @@index([status, startsAt])
}

model OperationalIncident {
  id              String    @id @default(uuid())
  eventId         String?
  category        String
  severity        String    @default("warning")
  status          String    @default("open")
  source          String
  summary         String
  details         Json?
  fingerprint     String?
  occurrenceCount Int       @default(1)
  lastSeenAt      DateTime  @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  Event           Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([fingerprint])
  @@index([status, severity, lastSeenAt])
  @@index([eventId, lastSeenAt])
  @@index([category, lastSeenAt])
}

model PromoCodeRecord {
  id             String   @id @default(uuid())
  code           String
  discountType   String
  discountValue  Int
  maxUses        Int      @default(100)
  usedCount      Int      @default(0)
  maxUsesPerUser Int      @default(1)
  minTickets     Int      @default(1)
  stackable      Boolean  @default(false)
  eventIds       String[] @default([])
  expiresAt      DateTime
  startsAt       DateTime @default(now())
  isActive       Boolean  @default(true)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([code])
  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
  @@index([isActive, expiresAt])
}

model PromoUsage {
  id        String   @id @default(uuid())
  promoCode String
  ticketId  String
  userId    String?
  eventId   String
  discount  Int
  createdAt DateTime @default(now())

  @@index([promoCode])
  @@index([userId])
  @@index([eventId])
  @@index([promoCode, createdAt])
}

model CertificateTemplate {
  id        String   @id @default(cuid())
  name      String
  eventId   String?  @unique
  Event     Event?   @relation(fields: [eventId], references: [id])
  bgImage   String?
  elements  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
