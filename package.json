    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:baseline": "tsx scripts/baseline-migrations.ts --apply",
    "postinstall": "prisma generate",
    "backfill:users": "tsx scripts/backfill-clerk-users.ts",
    "backfill:users:dry": "tsx scripts/backfill-clerk-users.ts --dry-run",
    "reconcile:sold-count": "tsx scripts/reconcile-sold-count.ts",
